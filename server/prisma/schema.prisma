// LifeLine — Production Prisma Schema
// Emergency Blood & Donor Network

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  DONOR
  RECIPIENT
  HOSPITAL_STAFF
  VOLUNTEER
  ADMIN
}

enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum UrgencyLevel {
  NORMAL
  URGENT
  CRITICAL
}

enum RequestStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  BROADCASTING
  DONOR_RESPONDED
  FULFILLED
  REJECTED
  CANCELLED
  EXPIRED
}

enum DonorResponseStatus {
  INTERESTED
  ACCEPTED
  ARRIVED
  DONATED
  CANCELLED
  REJECTED
}

enum OrganizationType {
  HOSPITAL
  BLOOD_BANK
  DIAGNOSTIC_CENTER
  CLINIC
}

enum OrgMemberRole {
  OWNER
  ADMIN
  STAFF
}

enum NotificationType {
  EMERGENCY_BROADCAST
  DONOR_MATCH
  REQUEST_STATUS_CHANGE
  DONATION_REMINDER
  SECURITY_ALERT
  SYSTEM
}

enum ReportType {
  FAKE_REQUEST
  UNRESPONSIVE_DONOR
  INCORRECT_INFORMATION
  HARASSMENT
  COMMERCIAL_SELLING
  OTHER
}

enum ReportStatus {
  PENDING
  INVESTIGATING
  RESOLVED
  DISMISSED
}

// ==========================================
// IDENTITY & AUTHENTICATION
// ==========================================

model User {
  id              String   @id @default(uuid())
  email           String   @unique
  phoneNumber     String   @unique
  passwordHash    String
  firstName       String
  lastName        String
  avatarUrl       String?
  role            Role     @default(DONOR)
  isEmailVerified Boolean  @default(false)
  isPhoneVerified Boolean  @default(false)
  isDeactivated   Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relationships
  donorProfile          DonorProfile?
  volunteerProfile      VolunteerProfile?
  organizationMembers   OrganizationMember[]
  refreshTokens         RefreshToken[]
  createdRequests       BloodRequest[]       @relation("UserCreatedRequests")
  reviewedRequests      BloodRequest[]       @relation("StaffReviewedRequests")
  donorResponses        DonorResponse[]
  receivedNotifications Notification[]       @relation("UserNotifications")
  filedReports          Report[]             @relation("UserFiledReports")
  resolvedReports       Report[]             @relation("AdminResolvedReports")
  auditLogs             AuditLog[]

  @@index([email])
  @@index([phoneNumber])
  @@index([role])
}

model RefreshToken {
  id         String   @id @default(uuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isRevoked  Boolean  @default(false)
  deviceInfo String?
  ipAddress  String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([tokenHash])
}

// ==========================================
// PROFILES
// ==========================================

model DonorProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  bloodGroup  BloodGroup
  gender      Gender     @default(PREFER_NOT_TO_SAY)
  dateOfBirth DateTime?

  // Bangladesh Geographic Hierarchy
  division       String // e.g. "Dhaka"
  district       String // e.g. "Dhaka"
  upazila        String // e.g. "Mirpur"
  addressDetails String?
  latitude       Float?
  longitude      Float?

  // Availability & Medical Eligibility
  isAvailable      Boolean   @default(true)
  lastDonationDate DateTime?
  totalDonations   Int       @default(0)
  weightKg         Float?

  // Privacy Controls (Zero-Trust)
  hidePhoneNumber     Boolean @default(true)
  hidePreciseLocation Boolean @default(true)
  allowEmergencyCalls Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  donationRecords DonationRecord[]

  @@index([bloodGroup, isAvailable])
  @@index([division, district, upazila])
  @@index([district, bloodGroup])
}

model VolunteerProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  division       String
  district       String
  upazila        String
  nidNumber      String? @unique
  isVerified     Boolean @default(false)
  badgeTitle     String? @default("Field Volunteer")
  tasksCompleted Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([district, isVerified])
}

// ==========================================
// ORGANIZATIONS (HOSPITALS & BLOOD BANKS)
// ==========================================

model Organization {
  id             String           @id @default(uuid())
  name           String
  type           OrganizationType @default(HOSPITAL)
  registrationNo String?          @unique
  contactEmail   String
  contactPhone   String

  division      String
  district      String
  upazila       String
  streetAddress String
  latitude      Float?
  longitude     Float?

  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  members       OrganizationMember[]
  bloodRequests BloodRequest[]

  @@index([district, type])
  @@index([name])
}

model OrganizationMember {
  id             String        @id @default(uuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           OrgMemberRole @default(STAFF)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, organizationId])
  @@index([organizationId])
}

// ==========================================
// EMERGENCY BLOOD REQUESTS & LIFECYCLE
// ==========================================

model BloodRequest {
  id          String @id @default(uuid())
  requesterId String
  requester   User   @relation("UserCreatedRequests", fields: [requesterId], references: [id], onDelete: Cascade)

  patientName     String
  patientAge      Int?
  patientGender   Gender?
  medicalReason   String?
  prescriptionUrl String?

  bloodGroup     BloodGroup
  unitsNeeded    Int        @default(1)
  unitsFulfilled Int        @default(0)

  hospitalName      String
  hospitalBedNumber String?
  organizationId    String?
  organization      Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  // Geographic Target
  division  String
  district  String
  upazila   String
  latitude  Float?
  longitude Float?

  urgencyLevel   UrgencyLevel  @default(NORMAL)
  status         RequestStatus @default(PENDING)
  requiredByDate DateTime
  expiresAt      DateTime

  // Verification Audit
  reviewedById String?
  reviewedBy   User?     @relation("StaffReviewedRequests", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNotes  String?
  verifiedAt   DateTime?
  fulfilledAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  donorResponses  DonorResponse[]
  donationRecords DonationRecord[]
  reports         Report[]

  @@index([status, requiredByDate])
  @@index([bloodGroup, district, status])
  @@index([division, district, upazila])
  @@index([requesterId])
}

model DonorResponse {
  id        String       @id @default(uuid())
  requestId String
  request   BloodRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  donorId   String
  donor     User         @relation(fields: [donorId], references: [id], onDelete: Cascade)

  status       DonorResponseStatus @default(INTERESTED)
  note         String?
  unitsPledged Int                 @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([requestId, donorId])
  @@index([donorId])
  @@index([requestId, status])
}

model DonationRecord {
  id             String        @id @default(uuid())
  requestId      String?
  request        BloodRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  donorProfileId String
  donorProfile   DonorProfile  @relation(fields: [donorProfileId], references: [id], onDelete: Cascade)

  bloodGroup      BloodGroup
  unitsDonated    Int        @default(1)
  donationDate    DateTime   @default(now())
  hospitalName    String
  verifiedByStaff String?
  certificateUrl  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([donorProfileId])
  @@index([donationDate])
}

// ==========================================
// NOTIFICATIONS & AUDITING
// ==========================================

model Notification {
  id          String @id @default(uuid())
  recipientId String
  recipient   User   @relation("UserNotifications", fields: [recipientId], references: [id], onDelete: Cascade)

  type   NotificationType @default(SYSTEM)
  title  String
  body   String
  data   Json?
  isRead Boolean          @default(false)
  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([recipientId, isRead])
  @@index([createdAt])
}

model AuditLog {
  id     String  @id @default(uuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  action     String // e.g. "AUTH_LOGIN", "DONOR_PHONE_VIEWED", "REQUEST_STATUS_UPDATED"
  entityType String // e.g. "User", "BloodRequest", "DonorProfile"
  entityId   String?
  ipAddress  String?
  userAgent  String?
  details    Json?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@index([action, createdAt])
}

model Report {
  id         String @id @default(uuid())
  reporterId String
  reporter   User   @relation("UserFiledReports", fields: [reporterId], references: [id], onDelete: Cascade)

  type      ReportType    @default(OTHER)
  requestId String?
  request   BloodRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)

  targetUserId String?
  reason       String
  evidenceUrl  String?

  status          ReportStatus @default(PENDING)
  resolvedById    String?
  resolvedBy      User?        @relation("AdminResolvedReports", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolutionNotes String?
  resolvedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([reporterId])
}

