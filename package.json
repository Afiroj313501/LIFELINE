{
  "name": "lifeline-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "LifeLine — Emergency Blood & Donor Network (Monorepo)",
  "scripts": {
    "dev": "concurrently -k -n \"API,CLIENT\" -c \"blue,green\" \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "build": "npm run build --prefix server && npm run build --prefix client",
    "typecheck": "npm run typecheck --prefix server && npm run typecheck --prefix client",
    "test": "npm run test --prefix server",
    "install:all": "npm install --prefix server && npm install --prefix client",
    "db:format": "npm --prefix server run db:format",
    "db:validate": "npm --prefix server run db:validate",
    "db:generate": "npm --prefix server run db:generate",
    "db:push": "npm --prefix server run db:push",
    "db:migrate": "npm --prefix server run db:migrate",
    "db:studio": "npm --prefix server run db:studio",
    "db:seed": "npm --prefix server run db:seed"
  },
  "keywords": [
    "blood-donation",
    "emergency-network",
    "bangladesh",
    "fullstack",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
